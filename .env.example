# AnimeVault environment configuration
# Copy this file to `.env` and adjust values as needed.

# Server
PORT=5173
HOST=127.0.0.1
NODE_ENV=development

# Data directory (default: ./data)
ANIMEVAULT_DATA=./data

# API token for programmatic access (optional; if set, required on all mutating API routes)
ANIMEVAULT_API_TOKEN=

# ── Admin account (AV-101 admin bootstrap) ──────────────────────────────
#
# Set these to create a super-admin account automatically on startup.
# The password hash is sha256(your_password) — compute it once and put the
# hex digest here. The actual password is never stored in plaintext.
#
# Example (password = "admin123"):
#   echo -n "admin123" | sha256sum
#   ANIMEVAULT_ADMIN_USERNAME=admin
#   ANIMEVAULT_ADMIN_PASSWORD_HASH=<64-hex-chars>
ANIMEVAULT_ADMIN_USERNAME=
ANIMEVAULT_ADMIN_PASSWORD_HASH=

# Allowed origins for CORS (comma/space separated)
ALLOWED_ORIGINS=

# Allowed external media hosts (comma/space separated)
ALLOWED_SOURCE_HOSTS=

# Library directory
LIBRARY_DIR=./library

# Max concurrent downloads
MAX_CONCURRENT_DOWNLOADS=2